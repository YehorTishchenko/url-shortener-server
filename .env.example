NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# Port 20379 matches docker-compose.yaml's host-mapped Redis port, for
# running the server locally against `docker compose up redis`.
REDIS_URL=redis://localhost:20379
REDIS_PASSWORD=change-me

# Port 55437 matches docker-compose.yaml's host-mapped Postgres port, for
# running the server locally against `docker compose up db`.
POSTGRES_USER=username
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dbname
DATABASE_URL=postgres://username:change-me@localhost:55437/dbname
